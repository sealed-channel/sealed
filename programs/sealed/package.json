{
  "name": "@sealed/contract",
  "version": "0.1.0",
  "private": true,
  "description": "Algorand TypeScript smart contract — top-up credits + username for Sealed.",
  "type": "module",
  "scripts": {
    "build": "puya-ts build src/contract.algo.ts --out-dir ../out --output-arc56",
    "deploy": "node --import tsx/esm src/deploy.ts",
    "deploy:localnet": "ALGORAND_NETWORK=localnet node --import tsx/esm src/deploy.ts",
    "deploy:testnet": "ALGORAND_NETWORK=testnet node --import tsx/esm src/deploy.ts",
    "deploy:mainnet": "ALGORAND_NETWORK=mainnet node --import tsx/esm src/deploy.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'",
    "post-commitment": "node --import tsx/esm src/scripts/post-commitment.ts",
    "gen-monetization-code": "node --import tsx/esm src/scripts/gen-monetization-code.ts",
    "gen-monetization-code:testnet": "ALGORAND_NETWORK=testnet node --import tsx/esm src/scripts/gen-monetization-code.ts",
    "gen-monetization-code:mainnet": "ALGORAND_NETWORK=mainnet node --import tsx/esm src/scripts/gen-monetization-code.ts",
    "seed-sale-pool": "node --import tsx/esm src/scripts/seed-sale-pool.ts",
    "seed-sale-pool:testnet": "ALGORAND_NETWORK=testnet node --import tsx/esm src/scripts/seed-sale-pool.ts",
    "seed-sale-pool:mainnet": "ALGORAND_NETWORK=mainnet node --import tsx/esm src/scripts/seed-sale-pool.ts",
    "migrate-v2": "node --import tsx/esm src/scripts/migrate-v2.ts",
    "migrate-v2:testnet": "ALGORAND_NETWORK=testnet node --import tsx/esm src/scripts/migrate-v2.ts",
    "list-commitments": "node --import tsx/esm src/scripts/list-commitments.ts",
    "list-commitments:testnet": "ALGORAND_NETWORK=testnet node --import tsx/esm src/scripts/list-commitments.ts",
    "list-commitments:mainnet": "ALGORAND_NETWORK=mainnet node --import tsx/esm src/scripts/list-commitments.ts",
    "topup-app-account": "node --import tsx/esm src/scripts/topup-app-account.ts",
    "topup-app-account:testnet": "ALGORAND_NETWORK=testnet node --import tsx/esm src/scripts/topup-app-account.ts",
    "topup-app-account:mainnet": "ALGORAND_NETWORK=mainnet node --import tsx/esm src/scripts/topup-app-account.ts",
    "gen-redeem-batch": "node --import tsx/esm src/scripts/gen-redeem-batch.ts",
    "upload-leaves": "node --import tsx/esm src/scripts/upload-leaves.ts",
    "redeem-as": "node --import tsx/esm src/scripts/redeem-as.ts",
    "send-as": "node --import tsx/esm src/scripts/send-as.ts",
    "balance-of": "node --import tsx/esm src/scripts/balance-of.ts",
    "create-channel": "node --import tsx/esm src/scripts/create-channel.ts",
    "accept-channel": "node --import tsx/esm src/scripts/accept-channel.ts",
    "send-alias": "node --import tsx/esm src/scripts/send-alias.ts",
    "publish-keys": "node --import tsx/esm src/scripts/publish-keys.ts",
    "update-app": "node --import tsx/esm src/scripts/update-app.ts",
    "update-app:testnet": "ALGORAND_NETWORK=testnet node --import tsx/esm src/scripts/update-app.ts",
    "e2e-channel:testnet": "ALGORAND_NETWORK=testnet node --import tsx/esm src/scripts/e2e-channel.ts"
  },
  "devDependencies": {
    "@algorandfoundation/algokit-utils": "^9.0.0",
    "@algorandfoundation/algorand-typescript": "^1.0.0",
    "@algorandfoundation/puya-ts": "^1.0.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "algosdk": "^3.0.0",
    "circomlibjs": "^0.1.7",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3"
  }
}
