# LP runtime env — copy to /mnt/sealed-data/secrets/lp.env (600) on the VPS.

# --- compose-level ---
LP_PG_PASSWORD=<generate: openssl rand -hex 24>
LP_REPO=/home/sealed/sealed-landing-page
SEALED_REPO=/home/sealed/sealed

# --- app: network (testnet values; flip for mainnet launch) ---
NEXT_PUBLIC_ALGO_NETWORK=testnet
NEXT_PUBLIC_APP_URL=https://sealed.channel
# contract app id (env-ized in PurchaseService.ts; testnet default below)
NEXT_PUBLIC_SEALED_APP_ID=763452863

# algod via OHTTP (Nodely gateway)
ALGOD_OHTTP_TARGET=https://testnet-api.4160.nodely.dev
ALGOD_OHTTP_RELAY=https://relay.oblivious.network/great-apple-60
ALGOD_OHTTP_GATEWAY_CONFIG=https://ohttp.nodely.io/ohttp-configs

# code delivery via OHTTP (our gateway on this VPS)
DELIVERY_OHTTP_TARGET=https://gw.sealed.channel
DELIVERY_OHTTP_RELAY=https://relay.oblivious.network/alter-ball-33
DELIVERY_OHTTP_GATEWAY_CONFIG=https://gw.sealed.channel/ohttp-configs

# --- app: misc ---
DEV_ACCESS_PASSWORD=<top-up gate password until mainnet pool live>

# Mainnet flip (day 2): set NEXT_PUBLIC_ALGO_NETWORK=mainnet,
# ALGOD_OHTTP_TARGET=https://mainnet-api.4160.nodely.dev, and
# NEXT_PUBLIC_SEALED_APP_ID=<mainnet app id from `pnpm deploy --new-wallet`>.
